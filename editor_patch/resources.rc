// Alpine Mesh Browser dialog
LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
IDD_ALPINE_MESH_BROWSER DIALOGEX 0, 0, 460, 288
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Select Mesh"
FONT 8, "MS Sans Serif"
{
    LTEXT           "Filter:", -1, 7, 9, 22, 8
    EDITTEXT        IDC_MESH_BROWSER_FILTER, 31, 7, 221, 12, ES_AUTOHSCROLL

    LTEXT           "Background:", -1, 258, 9, 42, 8
    AUTORADIOBUTTON "Editor", IDC_MESH_BROWSER_BG_EDITOR, 304, 8, 40, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "White", IDC_MESH_BROWSER_BG_WHITE, 348, 8, 40, 10
    AUTORADIOBUTTON "Black", IDC_MESH_BROWSER_BG_BLACK, 392, 8, 40, 10

    // Laid out split; the dialog grows the mesh tree over the animation pane whenever the
    // animation pane is hidden.
    CONTROL         "", IDC_MESH_BROWSER_TREE, WC_TREEVIEW, WS_GROUP | WS_BORDER | WS_TABSTOP | WS_VSCROLL | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, 24, 245, 112
    LTEXT           "Animations:", IDC_MESH_BROWSER_ANIM_LABEL, 7, 140, 44, 8
    CONTROL         "", IDC_MESH_BROWSER_ANIM_TREE, WC_TREEVIEW, WS_BORDER | WS_TABSTOP | WS_VSCROLL | TVS_HASBUTTONS | TVS_HASLINES | TVS_LINESATROOT | TVS_SHOWSELALWAYS, 7, 150, 245, 102

    // SS_NOTIFY makes the static return HTCLIENT from WM_NCHITTEST; without it the default
    // static proc returns HTTRANSPARENT and every mouse button message goes to the dialog.
    CONTROL         "", IDC_MESH_BROWSER_PREVIEW, "Static", SS_OWNERDRAW | SS_NOTIFY | WS_BORDER, 258, 24, 195, 152
    LTEXT           "", IDC_MESH_BROWSER_NAME, 258, 182, 195, 8
    LTEXT           "", IDC_MESH_BROWSER_TYPE, 258, 192, 195, 8
    LTEXT           "", IDC_MESH_BROWSER_SOURCE, 258, 202, 195, 8
    LTEXT           "", IDC_MESH_BROWSER_ANIM, 258, 212, 195, 8
    LTEXT           "", IDC_MESH_BROWSER_STATUS, 258, 226, 195, 8

    LTEXT           "", IDC_MESH_BROWSER_COUNT, 7, 268, 250, 8, WS_GROUP
    DEFPUSHBUTTON   "OK", IDOK, 339, 264, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 394, 264, 50, 14
}

