    CONTROL         "", IDC_WEATHER_SNOW_COLOR_PREVIEW, "Static", SS_OWNERDRAW | WS_BORDER, 176, 285, 24, 14
    PUSHBUTTON      "Pick", IDC_WEATHER_SNOW_COLOR_CHANGE, 206, 285, 36, 14
    LTEXT           "Fall Speed:", -1, 14, 307, 44, 8
    EDITTEXT        IDC_WEATHER_SNOW_FALL_SPEED, 60, 305, 40, 14, ES_AUTOHSCROLL
    LTEXT           "Sprite Radius:", -1, 108, 307, 48, 8
    EDITTEXT        IDC_WEATHER_SNOW_SPRITE_RADIUS, 160, 305, 40, 14, ES_AUTOHSCROLL
    LTEXT           "Sway Amp:", -1, 14, 327, 44, 8
