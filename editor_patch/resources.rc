    LTEXT           "Script Name:", -1, 7, 11, 44, 8
    EDITTEXT        IDC_ROPE_SCRIPT_NAME, 60, 9, 130, 14, ES_AUTOHSCROLL

    LTEXT           "Target UID:", -1, 7, 31, 44, 8
    EDITTEXT        IDC_ROPE_TARGET_UID, 60, 29, 44, 14, ES_AUTOHSCROLL
    LTEXT           "(-1 = hangs free)", -1, 108, 31, 60, 8
    // Resolved target, refreshed as the uid is typed
    LTEXT           "", IDC_ROPE_TARGET_INFO, 172, 31, 81, 8

    // Groups follow the weather region convention: 7 DLU interior margin, first row 14 below the
    // group top, rows pitched 20, 7 DLU below the last row.
    GROUPBOX        "Shape", -1, 7, 50, 245, 55
    // Tunable fields keep the weather region's metrics: a 40x14 edit with an 11x14 spinner on its
    // right edge (RED dialog 209), so every trailing column stays where it was.
    LTEXT           "Slack (m):", IDC_ROPE_SLACK_LABEL, 14, 66, 44, 8
    EDITTEXT        IDC_ROPE_SLACK, 60, 64, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin1", IDC_ROPE_SLACK_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 100, 64, 11, 14
    LTEXT           "Dangle Len (m):", IDC_ROPE_DANGLE_LENGTH_LABEL, 120, 66, 56, 8
    EDITTEXT        IDC_ROPE_DANGLE_LENGTH, 180, 64, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin2", IDC_ROPE_DANGLE_LENGTH_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 220, 64, 11, 14
    LTEXT           "Segments:", -1, 14, 86, 44, 8
    EDITTEXT        IDC_ROPE_SEGMENTS, 60, 84, 40, 14, ES_NUMBER
    CONTROL         "Spin3", IDC_ROPE_SEGMENTS_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 100, 84, 11, 14
    LTEXT           "Thickness (m):", -1, 120, 86, 52, 8
    EDITTEXT        IDC_ROPE_THICKNESS, 180, 84, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin4", IDC_ROPE_THICKNESS_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 220, 84, 11, 14

    GROUPBOX        "Appearance", -1, 7, 110, 245, 93
    // Color display + shared picker, matching the Level Properties sun color controls
    LTEXT           "Color:", -1, 14, 126, 24, 8
    CONTROL         "List1", IDC_ROPE_COLOR_SWATCH, WC_LISTVIEW, WS_BORDER | LVS_NOSCROLL | LVS_ICON, 40, 124, 32, 14, WS_EX_STATICEDGE
    PUSHBUTTON      "Change color", IDC_ROPE_COLOR_CHANGE, 76, 124, 52, 14
    EDITTEXT        IDC_ROPE_COLOR_VALUE, 132, 124, 46, 14, ES_AUTOHSCROLL
    LTEXT           "Alpha:", -1, 14, 146, 24, 8
    EDITTEXT        IDC_ROPE_COLOR_A, 40, 144, 32, 14, ES_NUMBER
    LTEXT           "Bitmap:", -1, 14, 166, 28, 8
    EDITTEXT        IDC_ROPE_BITMAP, 46, 164, 92, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "Browse...", IDC_ROPE_BITMAP_BROWSE, 142, 164, 38, 14
    // 49x49 preview, same size the weather region panel uses
    CONTROL         "", IDC_ROPE_BITMAP_PREVIEW, "Static", SS_OWNERDRAW | WS_BORDER, 196, 125, 49, 49
    LTEXT           "UV Tiles/m:", -1, 14, 186, 44, 8
    EDITTEXT        IDC_ROPE_UV_TILES, 60, 184, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin5", IDC_ROPE_UV_TILES_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 100, 184, 11, 14
    LTEXT           "(0 = stretch)", -1, 116, 186, 50, 8
    AUTOCHECKBOX    "Glow", IDC_ROPE_GLOW, 176, 185, 36, 10

    GROUPBOX        "Motion", -1, 7, 208, 245, 71
    AUTOCHECKBOX    "Dynamic", IDC_ROPE_DYNAMIC, 14, 222, 48, 10
    AUTOCHECKBOX    "Sway", IDC_ROPE_SWAY, 66, 222, 36, 10
    LTEXT           "Mass:", IDC_ROPE_WEIGHT_LABEL, 14, 240, 44, 8
    EDITTEXT        IDC_ROPE_WEIGHT, 60, 238, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin6", IDC_ROPE_WEIGHT_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 100, 238, 11, 14
    LTEXT           "Sway Amp (m):", IDC_ROPE_SWAY_AMPLITUDE_LABEL, 120, 240, 54, 8
    EDITTEXT        IDC_ROPE_SWAY_AMPLITUDE, 180, 238, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin7", IDC_ROPE_SWAY_AMPLITUDE_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 220, 238, 11, 14
    LTEXT           "Sway Speed:", IDC_ROPE_SWAY_SPEED_LABEL, 14, 260, 48, 8
    EDITTEXT        IDC_ROPE_SWAY_SPEED, 66, 258, 40, 14, ES_AUTOHSCROLL
    CONTROL         "Spin8", IDC_ROPE_SWAY_SPEED_SPIN, UPDOWN_CLASS, UDS_ARROWKEYS, 106, 258, 11, 14

    AUTOCHECKBOX    "Initially on", IDC_ROPE_INITIALLY_ON, 7, 287, 54, 10

    // The decoration list and its placement rules live in their own popup; the checkbox gates it
    // the same way the destructible checkbox gates the mesh panel's block.
    AUTOCHECKBOX    "Decorations", IDC_ROPE_DECORATIONS, 7, 305, 60, 10
    PUSHBUTTON      "Decorations...", IDC_ROPE_DECO_EDIT, 72, 302, 60, 14

    DEFPUSHBUTTON   "OK", IDOK, 145, 320, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 200, 320, 50, 14
}

